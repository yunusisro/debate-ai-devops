APP_NAME=Debate Assistant AI
DEBUG=True

# MongoDB connection string (replace with your own)
MONGODB_URL=mongodb+srv://<username>:<password>@<cluster-host>/<db>?retryWrites=true&w=majority
DATABASE_NAME=debate_assistant

# Groq API key
GROQ_API_KEY=YOUR_GROQ_API_KEY
# JWT configuration (replace with your own secret in production)
JWT_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
